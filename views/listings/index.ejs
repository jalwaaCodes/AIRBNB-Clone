<%layout('./layouts/bolierplate')%>

    <body>

        <div id="filters" class="d-flex align-items-center gap-4">


            <a href="/listings?category=Trending" class="filter text-decoration-none" style="margin-left: 2rem;">
                <i class="fa-solid fa-fire"></i>
                <p>Trending</p>
            </a>


            <a href="/listings?category=Rooms" class="filter text-decoration-none">
                <i class="fa-solid fa-bed"></i>
                <p>Rooms</p>
            </a>

            <a href="/listings?category=Iconic%20Cities" class="filter text-decoration-none">
                <i class="fa-solid fa-mountain-city"></i>
                <p>Iconic Cities</p>
            </a>

            <a href="/listings?category=Mountains" class="filter text-decoration-none">
                <i class="fa-solid fa-mountain"></i>
                <p>Mountains</p>
            </a>

            <a href="/listings?category=Amazing%20Pools" class="filter text-decoration-none">
                <i class="fa-solid fa-person-swimming"></i>
                <p>Amazing Pools</p>
            </a>

            <a href="/listings?category=Camping" class="filter text-decoration-none">
                <i class="fa-solid fa-campground"></i>
                <p>Camping</p>
            </a>

            <a href="/listings?category=Farms" class="filter text-decoration-none">
                <i class="fa-solid fa-cow"></i>
                <p>Farms</p>
            </a>

            <a href="/listings?category=Arctic" class="filter text-decoration-none">
                <i class="fa-regular fa-snowflake"></i>
                <p>Arctic</p>
            </a>

            <a href="/listings?category=Domes" class="filter text-decoration-none">
                <i class="fa-solid fa-igloo"></i>
                <p>Domes</p>
            </a>

            <a href="/listings?category=Boats" class="filter text-decoration-none">
                <i class="fa-solid fa-ship"></i>
                <p>Boats</p>
            </a>
            <div class="tax-toggle">
                <div class="form-check-reverse form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                    <label class="form-check-label" for="switchCheckDefault" style="color: #fe424d; width: 10rem;">Display total after taxes</label>
                </div>
            </div>
        </div>
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
            <%for(let listing of allListings){%>
                <a href="/listings/<%=listing._id%>" class="listing-link">
                    <div class="card col listing-card">
                        <img src="<%=listing.image.url%>" class="card-img-top" alt="listing_image"
                            style="height: 20rem;">
                        <div class="card-img-overlay"></div>
                        <div class="card-body">
                            <p class="card-text">
                                <b>
                                    <%=listing.title%>
                                </b> <br>
                                &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
                                    <!-- &#8377;<%= listing.price != null ? listing.price.toLocaleString("en-IN") : "N/A" %>/night -->
                                    <i class="tax-info">&nbsp;&nbsp;+18% GST</i>
                            </p>
                        </div>
                    </div>
                </a>
                <%}%>
        </div>
    </body>